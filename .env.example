# Demo works without credentials. Copy this to .env for live analysis.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Cost display only; does not enforce your provider's billing plan.
GROQ_FREE_TIER=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# OpenAI-compatible providers: choose openai above and set these.
OPENAI_API_KEY=
OPENAI_MODEL=openrouter/free
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=45
# Rule-based checks save free quota; true enables model reflection per step.
LLM_REFLECTION=false
API_BASE=http://localhost:8000
# Optional internal API secret; frontend sends it automatically, no user entry.
# The single-service launcher generates one automatically when absent.
AGENTIQ_API_TOKEN=
TAVILY_API_KEY=
SERPAPI_KEY=
OPENWEATHER_API_KEY=
ALPHAVANTAGE_API_KEY=
NEWSAPI_KEY=
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=
# Disable integrations until you configure and verify their credentials.
ENABLE_WEB_SEARCH=true
ENABLE_WEATHER=true
ENABLE_FINANCE=true
ENABLE_NEWS=true
ENABLE_EMAIL=true
